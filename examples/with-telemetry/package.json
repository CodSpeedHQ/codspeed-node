{
  "name": "with-telemetry",
  "private": true,
  "type": "module",
  "scripts": {
    "bench-benchmark-js": "node --import tsx bench/benchmark.js.bench.ts",
    "bench-tinybench": "node --import tsx bench/tinybench.bench.ts",
    "bench-vitest": "vitest bench --run",
    "typecheck": "tsc --noEmit --pretty"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/api-logs": "^0.223.0"
  },
  "devDependencies": {
    "@codspeed/benchmark.js-plugin": "workspace:*",
    "@codspeed/tinybench-plugin": "workspace:*",
    "@codspeed/vitest-plugin": "workspace:*",
    "@types/benchmark": "^2.1.2",
    "benchmark": "^2.1.4",
    "tinybench": "^4.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5.1.3",
    "vitest": "^5.0.0"
  }
}
